[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ellmer"]
	path = ellmer
	url = https://github.com/tidyverse/ellmer
	registered = false
[submodule "quallmer"]
	path = quallmer
	url = https://github.com/quallmer/quallmer
[submodule "quallmer.app"]
	path = quallmer.app
	url = https://github.com/quallmer/quallmer.app
